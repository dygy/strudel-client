{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strudel-client",
  "account_id": "503e92d7d95838d80c33802d3274f284",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  // dygy.app is served by Cloudflare nameservers, so the Worker can own this
  // hostname directly. Cloudflare creates and manages the DNS record for it.
  "routes": [{ "pattern": "strudel.dygy.app", "custom_domain": true }],
  // Public values only. SUPABASE_SERVICE_ROLE_KEY is a secret:
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // and locally it comes from .dev.vars (git-ignored).
  "vars": {
    "PUBLIC_SUPABASE_URL": "https://iarlunyimplczudavrcl.supabase.co",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TrzPO2LYvui4ipk9IKWiaQ_gsdZXQKX",
  },
}
