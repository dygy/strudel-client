{
  "name": "strudel_mcp_js",
  "version": "0.1.0",
  "description": "MCP server that runs Strudel patterns in a WebAssembly sandbox and returns their events, without audio",
  "type": "module",
  "bin": {
    "strudel-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.sandbox.config.js",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dygy/strudel-client.git",
    "directory": "packages/mcp-local"
  },
  "keywords": [
    "strudel",
    "mcp",
    "model-context-protocol",
    "livecoding",
    "tidalcycles"
  ],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://strudel.dygy.app",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@strudel/core": "workspace:*",
    "@strudel/mini": "workspace:*",
    "@strudel/tonal": "workspace:*",
    "@strudel/transpiler": "workspace:*",
    "acorn": "^8.14.0",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  }
}
